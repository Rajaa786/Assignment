# Root .env used by `docker compose` for variable interpolation (compose auto-reads
# ./.env). Copy to .env and fill in a key to enable real natural-language Q&A.
# Secrets live in the gitignored .env — never commit a real one.
#
#   cp .env.example .env   &&   edit .env   &&   docker compose up

# Force a provider, or leave "auto" to pick whichever key is set below.
LLM_PROVIDER=auto

# Provide ONE of these (or neither — the app falls back to a safe offline stub).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

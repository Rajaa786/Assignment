# Copy to .env for local development. Never commit a real .env.
# All values below are safe placeholders.

# Database. SQLite for local dev; a postgresql+psycopg URL in production (Neon).
# The driver is chosen from this URL — there is never more than one engine factory.
DATABASE_URL=sqlite:///./acme_salary.db

# Comma-separated CORS allowlist. Never "*".
CORS_ORIGINS=http://localhost:5173

# Structured logging: "json" for prod, "console" for local readability.
LOG_FORMAT=console
LOG_LEVEL=INFO

# Natural-language Q&A. The provider is auto-selected from whichever key is set,
# or force one with LLM_PROVIDER (auto | anthropic | gemini | stub). With no key it
# uses a safe offline stub, so the app always runs. Tests never call a real API.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional model override; each provider has a sensible default otherwise
# (Anthropic: claude-haiku-4-5-20251001, Gemini: gemini-2.5-flash).
# LLM_MODEL=
LLM_MAX_PROMPT_TOKENS=4000

# Base currency that all salaries are normalized to for cross-country comparison.
BASE_CURRENCY=USD
